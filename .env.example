# Export these variables, use the root .env, or pass Docker --env-file.
BANGUMI_DATA_URL=https://raw.githubusercontent.com/bangumi-data/bangumi-data/master/dist/data.json
BANGUMI_DATA_AUTO_UPDATE=1
BANGUMI_DATA_MAX_AGE_HOURS=24
# Optional: absolute path to an upstream dist/data.json file.
# BANGUMI_DATA_PATH=/app/data/cache/bangumi-data.json
# SCORE_CACHE_PATH=/app/data/cache/ratings.sqlite3
API_WORKERS=1
SCORE_AUTO_UPDATE=1
# Daily high-confidence Filmarks mapping for the current season.
FILMARKS_AUTO_MAP=1
# Optional operator access, alongside Bangumi administrator accounts.
# Anonymous loopback administration is available only when OAuth and this token are unconfigured.
# ANIMESCORE_ADMIN_TOKEN=replace-with-a-long-random-secret

# Bangumi OAuth application. The callback must exactly match the registered URI.
BGM_CLIENT_ID=
BGM_CLIENT_SECRET=
BGM_REDIRECT_URI=http://127.0.0.1:5001/api/v1/auth/bangumi/callback
# Comma-separated numeric UIDs, custom usernames, or Bangumi profile URLs.
# Examples: 123456,custom_username,https://bgm.tv/user/custom_username
# Applied on each user's FIRST verified OAuth login only; nickname is not an identifier.
# Existing users can be promoted/demoted in the admin UI.
BGM_ADMIN_IDS=

# OpenAI-compatible Chat Completions endpoint (base URL includes /v1 if required).
# Requires JSON-object responses; no automatic paid model retries.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Compose deployment options. Public OAuth requires an HTTPS callback.
# ANIMESCORE_IMAGE=ghcr.io/facjxzdt/animescore:latest
# ANIMESCORE_BIND=127.0.0.1
# ANIMESCORE_PORT=5001
# ANIMESCORE_DOMAIN=anime.example.com
# Compose reads service env_file as raw: write secret values without surrounding quotes.
